package main

import (
	"context"
	"errors"
	"fmt"
	"os"
	"os/signal"
	"syscall"
	"time"

	"github.com/saramand9/kpro/middleware"
	"github.com/saramand9/kpro/server"
	kproapp "{{.Module}}/internal/kproapp"
)

func main() {
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

func run() (returnErr error) {
	app, err := server.NewChecked(server.Config{
		Name:            "{{.ServiceName}}",
		ShutdownTimeout: 10 * time.Second,
	})
	if err != nil {
		return fmt.Errorf("invalid server configuration: %w", err)
	}
	defer func() {
		shutdownCtx, cancelShutdown := context.WithTimeout(context.Background(), 10*time.Second)
		defer cancelShutdown()
		returnErr = errors.Join(returnErr, app.Shutdown(shutdownCtx))
	}()
	if err := app.UseChecked(middleware.Recover(), middleware.MaxPayload(1<<20)); err != nil {
		return fmt.Errorf("install application middleware: %w", err)
	}
	if err := kproapp.Mount(app); err != nil {
		return fmt.Errorf("mount service endpoints: %w", err)
	}

	baseCtx, cancelRun := context.WithCancel(context.Background())
	defer cancelRun()
	runCtx, stopSignals := signal.NotifyContext(baseCtx, os.Interrupt, syscall.SIGTERM)
	defer stopSignals()
	handle, err := app.Start(runCtx)
	if err != nil {
		return fmt.Errorf("start service: %w", err)
	}
	readyCtx, cancelReady := context.WithTimeout(context.Background(), 15*time.Second)
	if err := handle.WaitReady(readyCtx); err != nil {
		cancelReady()
		cancelRun()
		runErr := handle.Wait()
		if server.IsContextTermination(runErr) {
			runErr = nil
		}
		return errors.Join(fmt.Errorf("service failed before readiness: %w", err), runErr)
	}
	cancelReady()

	if err := handle.Wait(); err != nil {
		if server.IsContextTermination(err) && runCtx.Err() != nil {
			return nil
		}
		return fmt.Errorf("service stopped: %w", err)
	}
	return nil
}
