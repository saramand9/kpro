package main

import (
	"context"
	"errors"
	"fmt"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"github.com/saramand9/kpro/middleware"
	"github.com/saramand9/kpro/observability/zapx"
	"github.com/saramand9/kpro/server"
	"github.com/saramand9/kpro/transport/httpx"
	"go.uber.org/zap"
)

func main() {
	if err := run(); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}

func run() (returnErr error) {
	logger, err := zap.NewProduction()
	if err != nil {
		return fmt.Errorf("initialize logger: %w", err)
	}
	defer logger.Sync()

	app, err := server.NewChecked(server.Config{
		Name:            "{{.ServiceName}}",
		ShutdownTimeout: 10 * time.Second,
	})
	if err != nil {
		return fmt.Errorf("invalid server configuration: %w", err)
	}
	defer func() {
		shutdownCtx, cancelShutdown := context.WithTimeout(context.Background(), 10*time.Second)
		defer cancelShutdown()
		returnErr = errors.Join(returnErr, app.Shutdown(shutdownCtx))
	}()
	app.Use(
		middleware.Recover(),
		zapx.Middleware(logger),
		middleware.MaxPayload(1<<20),
	)
	httpEndpoint := server.MountNative(app, httpx.New(httpx.Config{
		Addr:            ":8080",
		ReadTimeout:     5 * time.Second,
		WriteTimeout:    10 * time.Second,
		IdleTimeout:     60 * time.Second,
		ShutdownTimeout: 10 * time.Second,
		MaxBodyBytes:    1 << 20,
	}))
	liveness := func(ctx *httpx.Context) error {
		return ctx.JSON(http.StatusOK, map[string]string{"status": "alive"})
	}
	readiness := func(ctx *httpx.Context) error {
		return ctx.JSON(http.StatusOK, map[string]string{
			"status":       "ready",
			"dependencies": "none",
		})
	}
	httpEndpoint.Get("/livez", liveness)
	httpEndpoint.Get("/readyz", readiness)
	httpEndpoint.Get("/healthz", readiness)
	httpEndpoint.Get("/hello", func(ctx *httpx.Context) error {
		return ctx.JSON(http.StatusOK, map[string]string{"message": "hello from {{.ServiceName}}"})
	})

	baseCtx, cancelRun := context.WithCancel(context.Background())
	defer cancelRun()
	runCtx, stopSignals := signal.NotifyContext(baseCtx, os.Interrupt, syscall.SIGTERM)
	defer stopSignals()
	handle, err := app.Start(runCtx)
	if err != nil {
		return fmt.Errorf("start service: %w", err)
	}
	readyCtx, cancelReady := context.WithTimeout(context.Background(), 15*time.Second)
	if err := handle.WaitReady(readyCtx); err != nil {
		cancelReady()
		cancelRun()
		runErr := handle.Wait()
		if server.IsContextTermination(runErr) {
			runErr = nil
		}
		return errors.Join(fmt.Errorf("service failed before readiness: %w", err), runErr)
	}
	cancelReady()

	logger.Info("service ready", zap.String("address", ":8080"))
	if err := handle.Wait(); err != nil {
		if server.IsContextTermination(err) && runCtx.Err() != nil {
			return nil
		}
		return fmt.Errorf("service stopped: %w", err)
	}
	return nil
}
