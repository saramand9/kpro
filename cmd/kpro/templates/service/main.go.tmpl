package main

import (
	"context"
	"errors"
	"net/http"
	"os"
	"os/signal"
	"syscall"
	"time"

	"github.com/saramand9/bignet/kpro/middleware"
	"github.com/saramand9/bignet/kpro/observability/zapx"
	"github.com/saramand9/bignet/kpro/server"
	"github.com/saramand9/bignet/kpro/transport/httpx"
	"go.uber.org/zap"
)

func main() {
	logger, err := zap.NewProduction()
	if err != nil {
		panic(err)
	}
	defer logger.Sync()

	app, err := server.NewChecked(server.Config{
		Name:            "{{.ServiceName}}",
		ShutdownTimeout: 10 * time.Second,
	})
	if err != nil {
		logger.Fatal("invalid server configuration", zap.Error(err))
	}
	app.Use(
		middleware.Recover(),
		zapx.Middleware(logger),
		middleware.MaxPayload(1<<20),
	)
	httpEndpoint := app.HTTP(":8080", httpx.Config{
		ReadTimeout:     5 * time.Second,
		WriteTimeout:    10 * time.Second,
		IdleTimeout:     60 * time.Second,
		ShutdownTimeout: 10 * time.Second,
		MaxBodyBytes:    1 << 20,
	})
	httpEndpoint.Get("/healthz", func(ctx *httpx.Context) error {
		return ctx.JSON(http.StatusOK, map[string]string{"status": "ok"})
	})
	httpEndpoint.Get("/hello", func(ctx *httpx.Context) error {
		return ctx.JSON(http.StatusOK, map[string]string{"message": "hello from {{.ServiceName}}"})
	})

	shutdownSignals, stopSignals := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stopSignals()
	go func() {
		<-shutdownSignals.Done()
		ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
		defer cancel()
		if err := app.Shutdown(ctx); err != nil && !errors.Is(err, context.Canceled) {
			logger.Error("shutdown failed", zap.Error(err))
		}
	}()

	logger.Info("service listening", zap.String("address", ":8080"))
	if err := app.ListenAndServe(); err != nil {
		logger.Fatal("service stopped", zap.Error(err))
	}
}
